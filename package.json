{
  "name": "tailgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Farm to door: farmers list what they have, customers order it, drivers carry it. A Zubra showcase on one small Node server.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test test/app.test.js test/admin.test.js",
    "design-check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@potomac-solutions/kit": "github:Potomac-Solutions/kit#c0d08987112f69b480fab50c6c266c82a34f3f1c",
    "@zubra/actions": "^6.0.5",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
